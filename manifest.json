{
  "manifest_version": 3,
  "name": "Jira Ticket Copier",
  "version": "1.7.0",
  "description": "Grabs the key and title of a Jira ticket and copies them to the clipboard (customizable formats, popup and Jira page). Quick auto-assign to chosen people.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.atlassian.net/*"],
      "js": ["settings.js", "template-engine.js", "extract-core.js", "i18n.js", "extract-fn.js", "page-buttons.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Copy Jira ticket",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-pane": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open / close the Jira copy panel"
    },
    "copy-ticket-full": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Copy \"Key + title\" of the Jira ticket"
    },
    "copy-ticket-branch": {
      "description": "Copy the git branch name of the Jira ticket"
    },
    "copy-ticket-markdown": {
      "description": "Copy the Markdown link of the Jira ticket"
    }
  }
}
